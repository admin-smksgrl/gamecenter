                },
                {
                  "term": "Higrofit",
                  "definition": "Tanaman yang hidup di tempat lembap, seperti lumut dan tanaman paku."
                },
                {
                  "term": "Xerofit",
                  "definition": "Tanaman yang hidup di daerah kering, seperti kaktus dan lidah buaya."
                },
                {
                  "term": "Soil moisture",
                  "definition": "Sensor yang mengukur kadar air atau kelembapan tanah."
                },
                {
                  "term": "Timer",
                  "definition": "Pengatur waktu yang menyalakan atau mematikan alat secara terjadwal."
                },
                {
                  "term": "Irigasi tetes",
                  "definition": "Teknik penyiraman dengan meneteskan air langsung ke akar tanaman."
