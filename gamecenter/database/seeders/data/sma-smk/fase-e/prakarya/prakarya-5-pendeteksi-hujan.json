                },
                {
                  "term": "Buzzer",
                  "definition": "Komponen listrik yang menghasilkan bunyi sebagai tanda peringatan."
                },
                {
                  "term": "Mitigasi",
                  "definition": "Upaya pencegahan dan pengurangan risiko sebelum bencana terjadi."
                },
                {
                  "term": "Curah hujan",
                  "definition": "Jumlah air hujan yang jatuh pada suatu area dalam waktu tertentu."
                },
                {
                  "term": "BMKG",
                  "definition": "Badan Meteorologi, Klimatologi, dan Geofisika yang mengukur cuaca di Indonesia."
