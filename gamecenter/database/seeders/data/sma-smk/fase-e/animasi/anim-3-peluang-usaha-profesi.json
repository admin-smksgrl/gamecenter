              "type": "glossary",
              "id": "anim-3-peluang-usaha-profesi-glosarium",
              "terms": [
                {
                  "term": "Produser",
                  "definition": "Perencana anggaran dan waktu produksi, pengelola tim, serta penjaga hubungan dengan klien dan investor."
                },
                {
                  "term": "Scriptwriter",
                  "definition": "Penulis naskah: mengembangkan konsep cerita, karakter, plot, dan dialog."
                },
                {
                  "term": "Storyboard artist",
                  "definition": "Menerjemahkan naskah menjadi rangkaian gambar visual."
                },
                {
                  "term": "Layout artist",
                  "definition": "Mendesain shot frame, angle, pergerakan kamera, dan pencahayaan adegan."
                },
                {
                  "term": "Animator",
                  "definition": "Pembuat gerakan karakter dan objek melalui keyframe atau motion capture."
                },
                {
                  "term": "Composer",
                  "definition": "Pembuat musik utama, musik latar, dan efek suara animasi."
                },
                {
                  "term": "Compositor",
                  "definition": "Menggabungkan elemen-elemen animasi menjadi satu tampilan utuh."
                },
                {
                  "term": "Technopreneur",
                  "definition": "Wirausaha yang memanfaatkan teknologi untuk menjalankan bisnis."
                },
                {
                  "term": "Business Model Canvas",
                  "definition": "Kerangka sembilan elemen untuk merancang model bisnis."
                },
                {
                  "term": "Pitch bible",
                  "definition": "Dokumen presentasi berisi konsep, desain karakter, dan alur untuk menarik investor atau studio."
