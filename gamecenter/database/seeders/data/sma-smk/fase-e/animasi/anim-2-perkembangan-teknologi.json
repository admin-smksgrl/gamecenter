            {
              "type": "glossary",
              "id": "anim-2-perkembangan-teknologi-glosarium",
              "terms": [
                {
                  "term": "Animasi",
                  "definition": "Proses merekam lalu memutar kembali rangkaian gambar diam untuk menciptakan ilusi gerak."
                },
                {
                  "term": "Praxinoscope",
                  "definition": "Alat proyeksi gambar berputar yang dikembangkan Charles Émile Reynaud."
                },
                {
                  "term": "Cell animation",
                  "definition": "Teknik memisahkan latar diam dan bagian bergerak pada seluloid transparan, ditemukan Earl Hurd (1914)."
                },
                {
                  "term": "Stop-motion",
                  "definition": "Teknik memindahkan objek secara fisik sedikit demi sedikit lalu direkam per frame."
                },
                {
                  "term": "Claymation",
                  "definition": "Stop-motion yang memakai bahan lunak seperti tanah liat atau plastisin, disangga armature."
                },
                {
                  "term": "Object-motion",
                  "definition": "Stop-motion yang menggerakkan benda padat seperti mainan atau balok."
                },
                {
                  "term": "Pixilation",
                  "definition": "Stop-motion yang menggunakan manusia sebagai objek yang digerakkan per frame."
                },
                {
                  "term": "CGI",
                  "definition": "Computer-Generated Imagery, gambar yang dibuat dengan komputer dalam film."
                },
                {
                  "term": "DCP",
                  "definition": "Digital Cinema Package, format standar pengiriman dan pemutaran film di bioskop digital."
                },
                {
                  "term": "KDM",
                  "definition": "Key Delivery Message, kunci untuk membuka DCP yang terenkripsi."
                },
                {
                  "term": "Product life cycle",
                  "definition": "Siklus hidup produk: introduksi, pertumbuhan, kematangan, dan penurunan."
                }
              ]
