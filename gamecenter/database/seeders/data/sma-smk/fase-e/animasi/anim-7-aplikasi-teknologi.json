                {
                  "term": "TVPaint",
                  "definition": "Aplikasi animasi berbasis bitmap yang merepresentasikan media seni alami."
                },
                {
                  "term": "After Effect",
                  "definition": "Aplikasi untuk motion graphic, visual FX, dan compositing."
