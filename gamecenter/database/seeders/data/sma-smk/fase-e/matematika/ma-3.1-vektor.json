                  "term": "Skalar",
                  "definition": "Besaran yang hanya punya besar, misalnya massa, suhu, dan waktu."
                },
                {
                  "term": "Vektor",
                  "definition": "Besaran yang punya besar sekaligus arah, misalnya perpindahan dan gaya."
                },
                {
                  "term": "Komponen vektor",
                  "definition": "Bagian mendatar (x) dan tegak (y) yang menyusun sebuah vektor."
                },
                {
                  "term": "Vektor satuan",
                  "definition": "Vektor berpanjang 1 yang menunjukkan arah vektor asal, v̂ = v ÷ |v|."
                }
