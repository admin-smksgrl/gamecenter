                  "term": "Mean",
                  "definition": "Jumlah seluruh data dibagi banyak data (rata-rata)."
                },
                {
                  "term": "Median",
                  "definition": "Nilai tengah setelah data diurutkan; untuk data genap diambil rata-rata dua nilai tengah."
                },
                {
                  "term": "Modus",
                  "definition": "Nilai yang paling sering muncul dalam data."
                },
                {
                  "term": "Jangkauan",
                  "definition": "Selisih data terbesar dan data terkecil, menggambarkan sebaran data."
                }
              ]
