              "terms": [
                {
                  "term": "Nomor atom (Z)",
                  "definition": "Jumlah proton dalam inti atom; menentukan jenis unsur."
                },
                {
                  "term": "Nomor massa (A)",
                  "definition": "Jumlah proton ditambah neutron, ditulis sebagai bilangan bulat."
                },
                {
                  "term": "Isotop",
                  "definition": "Atom dengan nomor atom sama tetapi nomor massa berbeda, misalnya ¹²C dan ¹⁴C."
                },
                {
                  "term": "Elektron valensi",
                  "definition": "Elektron pada kulit terluar yang menentukan sifat kimia atom."
                }
              ]
            },
