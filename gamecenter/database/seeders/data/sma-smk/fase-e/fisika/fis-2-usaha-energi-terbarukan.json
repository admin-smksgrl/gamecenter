            {
              "type": "glossary",
              "terms": [
                {
                  "term": "Usaha",
                  "definition": "Hasil kali gaya dengan perpindahan searah gaya, W = F × s × cos θ."
                },
                {
                  "term": "Daya",
                  "definition": "Usaha yang dilakukan per satuan waktu, P = W ÷ t, satuannya watt."
                },
                {
                  "term": "Energi kinetik",
                  "definition": "Energi yang dimiliki benda karena bergerak, Ek = ½mv²."
                },
                {
                  "term": "Energi potensial",
                  "definition": "Energi yang dimiliki benda karena posisinya, Ep = mgh."
                }
              ]
            },
