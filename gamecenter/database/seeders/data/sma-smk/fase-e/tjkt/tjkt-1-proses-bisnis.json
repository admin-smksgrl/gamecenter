            {
              "type": "glossary",
              "id": "tjkt-1-proses-bisnis-glosarium",
              "terms": [
                {
                  "term": "Proses bisnis",
                  "definition": "Rangkaian tahapan kegiatan terstruktur yang menghasilkan barang atau jasa dengan tujuan ekonomi."
                },
                {
                  "term": "Core business",
                  "definition": "Aktivitas utama bisnis yang menjadi sumber utama nilai dan pendapatan perusahaan."
                },
                {
                  "term": "Analisis kebutuhan",
                  "definition": "Kajian terhadap kebutuhan pengguna seperti jumlah pengguna, perangkat, dan layanan jaringan."
                },
                {
                  "term": "Grup kerja",
                  "definition": "Kelompok dalam organisasi dengan fungsi dan tanggung jawab yang terbagi terstruktur."
                },
                {
                  "term": "ISP",
                  "definition": "Penyedia layanan internet (Internet Service Provider) yang menghubungkan pelanggan ke internet."
                },
                {
                  "term": "Jaringan komputer",
                  "definition": "Kumpulan perangkat yang saling terhubung untuk berbagi sumber daya dan data."
                },
                {
                  "term": "Media koneksi",
                  "definition": "Sarana penghubung antarderangkat jaringan, seperti kabel tembaga, serat optik, atau nirkabel."
                },
                {
                  "term": "Pengalamatan IP",
                  "definition": "Pemberian alamat unik pada perangkat agar dapat berkomunikasi dalam jaringan."
                },
                {
                  "term": "Firewall",
                  "definition": "Sistem keamanan yang mengatur izin lalu lintas data masuk dan keluar jaringan."
                }
              ]
