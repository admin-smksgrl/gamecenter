                {
                  "term": "Profesi",
                  "definition": "Pekerjaan yang membutuhkan keterampilan khusus yang diperoleh melalui pendidikan dan memiliki kode etik."
                },
                {
                  "term": "Kewirausahaan",
                  "definition": "Aktivitas menciptakan atau mengembangkan usaha yang inovatif dan berkelanjutan."
                },
                {
                  "term": "Wirausaha",
                  "definition": "Orang yang menjalankan kewirausahaan dengan berani mengambil risiko dan melihat peluang."
                },
                {
                  "term": "Technopreneur",
                  "definition": "Pengusaha yang memanfaatkan teknologi informasi untuk menjalankan dan memperluas usaha."
                },
                {
                  "term": "Sertifikasi",
                  "definition": "Bukti legal kompetensi seseorang di bidang tertentu, pengakuan profesi secara nasional atau internasional."
                },
                {
                  "term": "SKKNI",
                  "definition": "Standar Kompetensi Kerja Nasional Indonesia yang merumuskan kemampuan kerja sesuai tugas dan jabatan."
                },
                {
                  "term": "KKNI",
                  "definition": "Kerangka Kualifikasi Nasional Indonesia yang menetapkan level kualifikasi dan jenjang jabatan."
                },
                {
                  "term": "Etika bisnis",
                  "definition": "Rambu-rambu dan sopan santun dalam menjalankan usaha untuk menjaga reputasi."
                },
                {
                  "term": "Peluang usaha",
                  "definition": "Kesempatan untuk memperoleh keuntungan dengan memanfaatkan sumber daya yang dimiliki."
                },
                {
                  "term": "Passion",
                  "definition": "Ketertarikan dan kegemaran mendalam yang menjadi pendorong bekerja dan berkarya."
                }
