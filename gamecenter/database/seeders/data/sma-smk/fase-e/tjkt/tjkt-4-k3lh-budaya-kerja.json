            {
              "type": "glossary",
              "id": "tjkt-4-k3lh-budaya-kerja-glosarium",
              "terms": [
                {
                  "term": "K3LH",
                  "definition": "Keselamatan dan Kesehatan Kerja Lingkungan Hidup untuk melindungi tenaga kerja dari kecelakaan dan penyakit akibat kerja."
                },
                {
                  "term": "Antisipasi",
                  "definition": "Upaya memprediksi bahaya dan risiko yang mungkin terjadi di tempat kerja."
                },
                {
                  "term": "Rekognisi",
                  "definition": "Upaya mengenali bahaya lingkungan kerja dan pengaruhnya terhadap karyawan."
                },
                {
                  "term": "Evaluasi",
                  "definition": "Penilaian kuantitatif dan pemantauan dampak bahaya lingkungan kerja."
                },
                {
                  "term": "Kendali",
                  "definition": "Upaya menghilangkan atau mengurangi bahaya lingkungan kerja."
                },
                {
                  "term": "Hierarki pengendalian",
                  "definition": "Urutan prioritas pengendalian bahaya: eliminasi, substitusi, rekayasa, administrasi, sampai APD."
                },
                {
                  "term": "Eliminasi",
                  "definition": "Menghilangkan sumber bahaya sampai ke titik aman."
                },
                {
                  "term": "Substitusi",
                  "definition": "Mengganti peralatan atau bahan dengan yang lebih aman."
                },
                {
                  "term": "APD",
                  "definition": "Alat pelindung diri seperti helm, kacamata, sarung tangan, dan pelindung telinga."
                },
                {
                  "term": "5R",
                  "definition": "Ringkas, Rapi, Resik, Rawat, dan Rajin untuk mengelola lingkungan kerja agar efisien."
                }
              ]
