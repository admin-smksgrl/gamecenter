                  "term": "Historiografi tradisional",
                  "definition": "Penulisan sejarah bercorak istana dan religius-magis, berpusat pada raja dan dinasti."
                },
                {
                  "term": "Historiografi kolonial",
                  "definition": "Penulisan sejarah dari sudut pandang penjajah yang menempatkan Belanda sebagai tokoh utama."
                },
                {
                  "term": "Historiografi nasional",
                  "definition": "Penulisan sejarah berpusat pada bangsa Indonesia sebagai pelaku utama, tumbuh setelah kemerdekaan."
                },
                {
                  "term": "Historiografi modern",
                  "definition": "Penulisan sejarah yang kritis, memakai ilmu bantu, dan menguji sumber secara terbuka."
