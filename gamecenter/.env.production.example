# =====================================================================
# Template environment PRODUKSI — Game Center Edukasi
#
# Cara pakai:
#   1. Salin berkas ini menjadi .env di server (jangan commit .env).
#   2. Ganti semua nilai bertanda >>> GANTI <<<.
#   3. Jalankan: php artisan key:generate
#   4. Verifikasi: php artisan gamecenter:deploy-check --strict
#
# Berkas ini sengaja TIDAK memuat kredensial asli.
# =====================================================================

APP_NAME="Game Center Edukasi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# >>> GANTI <<< dengan domain asli, wajib https.
APP_URL=https://gamecenter.example.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Produksi: daily agar log tidak memenuhi kuota shared hosting.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=>>> GANTI <<< nama_database
DB_USERNAME=>>> GANTI <<< user_database
DB_PASSWORD=>>> GANTI <<< kata_sandi_kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Wajib berisi domain produksi (tanpa skema) agar cookie Sanctum berlaku.
# >>> GANTI <<<
SANCTUM_STATEFUL_DOMAINS=gamecenter.example.id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Shared hosting: cache database lebih aman daripada file multi-proses.
CACHE_STORE=database

# Shared hosting biasanya tidak menyediakan Redis/Memcached.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# >>> GANTI <<< dengan SMTP penyedia surel produksi.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=>>> GANTI <<< smtp.penyedia.com
MAIL_PORT=587
MAIL_USERNAME=>>> GANTI <<<
MAIL_PASSWORD=>>> GANTI <<<
MAIL_FROM_ADDRESS="no-reply@gamecenter.example.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Keanggotaan (tampil di halaman /keanggotaan) --------------------
MEMBERSHIP_BANK_NAME=">>> GANTI <<<"
MEMBERSHIP_BANK_NUMBER=">>> GANTI <<<"
MEMBERSHIP_BANK_HOLDER=">>> GANTI <<<"

# --- AI penilaian esai (kosongkan bila belum dipakai) ---------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
